      "id": "c4459460-a3e3-4629-9c69-8cf2ac7271db",
      "name": "RPC Create Hold",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        280,
        -220
      ]
    },
    {
      "parameters": {
        "jsCode": "const payload = Array.isArray($json) ? $json[0] : $json;\nconst errorMessage = [\n  payload?.message,\n  payload?.details,\n  payload?.hint,\n  payload?.error?.message,\n  payload?.error?.description,\n].filter(Boolean).join(' ');\n\nif (payload?.code || payload?.error) {\n  const expectedConflict = /Requested slot is no longer available|appointments_no_active_overlap|conflicting key value|exclusion constraint|overlap/i.test(errorMessage);\n\n  if (expectedConflict) {\n    return [{\n      json: {\n        status: 'slot_not_available',\n        message: 'El turno acaba de dejar de estar disponible. Elegí otro horario.',\n      },\n    }];\n  }\n\n  throw new Error(`Unexpected create_hold RPC error: ${errorMessage || JSON.stringify(payload)}`);\n}\n\nreturn [{\n  json: {\n    appointment_id: payload.id,\n    status: payload.status,\n    professional_id: payload.professional_id,\n    service_id: payload.service_id,\n    starts_at: payload.starts_at,\n    blocks_until: payload.blocks_until,\n    hold_expires_at: payload.hold_expires_at,\n  },\n}];"
      },
