        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"p_business_id\": \"{{$json.business_id}}\",\n  \"p_service_id\": \"{{$json.service_id}}\",\n  \"p_local_date\": \"{{$json.date}}\",\n  \"p_slot_step\": \"5 minutes\"\n}",
