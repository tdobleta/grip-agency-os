      "id": "395094fc-50d3-4abf-ae26-bdffb7bf2145",
      "name": "RPC Available Slots",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -400,
        -120
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $('Demo Input').first().json;\nconst slots = $input.all().map((item) => item.json);\nconst selectedTime = new Date(input.selected_start_at).getTime();\nconst matchingSlot = slots.find((slot) => {\n  return slot.professional_id === input.professional_id && new Date(slot.slot_start_at).getTime() === selectedTime;\n});\n\nreturn [{\n  json: {\n    ...input,\n    available_slots: slots,\n    selected_slot_available: Boolean(matchingSlot),\n    selected_slot: matchingSlot || null,\n  },\n}];"
      },
      "id": "d0745da0-7518-4916-ab95-b9dc5b591068",
